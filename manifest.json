{
  "manifest_version": 3,
  "name": "YouTube TV Mode",
  "version": "1.1.0",
  "description": "Enables YouTube TV mode on desktop with enhanced features.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-48.png",
    "default_title": "YouTube TV Mode"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "lib/defaults.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://sponsor.ajay.app/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/defaults.js",
        "lib/thumbnail-url.js",
        "shared/page-init.js",
        "shared/settings-bridge.js",
        "shared/json-interceptor.js",
        "shared/player-utils.js",
        "features/adblock.js",
        "features/deviceSpoof.js",
        "features/forceResolution.js",
        "features/backgroundPlayback.js",
        "features/leanbackMode.js",
        "features/highQualityThumbnails.js",
        "features/keyRemapping.js",
        "features/playbackSpeed.js",
        "features/hideGuide.js",
        "features/sponsorblock.js",
        "settingsIntegration.js",
        "styles/leanback.css"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
